# Preparation only. No production configuration changes have been applied.
CHECKOUT_PROVIDER=prodamus
CLOUDPAYMENTS_ENABLED=false
CLOUDPAYMENTS_MODE=test
# MODE validates callbacks; it DOES NOT switch the merchant terminal to sandbox.
# Obtain explicit confirmation of the terminal's actual mode before setting true.
CLOUDPAYMENTS_TERMINAL_MODE_CONFIRMED=false
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
CLOUDPAYMENTS_RECEIPT_APPROVED=false
# Full JsonData object approved by CloudPayments + merchant's accountant.
# Whole values "$amount", "$email", "$product" are replaced server-side.
# Do not guess taxation system, VAT, receipt object/method, or fiscal provider.
CLOUDPAYMENTS_RECEIPT_TEMPLATE_JSON=
