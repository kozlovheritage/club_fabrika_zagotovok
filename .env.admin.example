# Server feature gate. Leave false until separately approved release.
CLUB_ADMIN_ENABLED=false
# Private recipient for generic failure/recovery warnings. Never place in source.
CLUB_ADMIN_ALERT_EMAIL=

# Provisioning-process variables only. Do NOT set on normal app startup.
# Verify DATABASE_URL/PUBLIC_URL identify the explicitly approved target.
CLUB_ADMIN_PROVISION_CONFIRMED=false
CLUB_ADMIN_PROVISION_TARGET_URL=
CLUB_ADMIN_TARGET_EMAIL=
CLUB_ADMIN_EXPECTED_NAME=
CLUB_ADMIN_DISPLAY_NAME=
